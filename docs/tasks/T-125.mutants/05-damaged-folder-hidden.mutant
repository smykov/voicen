guarantee: AC5: a damaged folder lists as damaged, never hidden
file: crates/voicen-core/src/call/storage.rs
added_by: test-writer
--- old
                entries.push(load_entry(root, id));
--- new
                let entry = load_entry(root, id);
                if entry.state != ListState::Damaged {
                    entries.push(entry);
                }
--- end
