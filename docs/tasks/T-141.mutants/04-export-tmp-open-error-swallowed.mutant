guarantee: AC5: a target folder that cannot take the tmp returns ioFailed{reason} (export_to propagates the open error)
file: crates/voicen-core/src/call/storage.rs
added_by: developer
test: cargo test -j2 -p voicen-core --lib call::storage::tests::export_
--- old
    let (file, tmp) = reserve_export_tmp(dir, name).map_err(|e| CallError::io_failed(e.kind()))?;
--- new
    let Ok((file, tmp)) = reserve_export_tmp(dir, name) else {
        return Ok(());
    };
--- end
