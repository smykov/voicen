guarantee: AC5: a failed rename leaves no tmp and returns ioFailed{reason} (fill_and_rename propagates the rename error)
file: crates/voicen-core/src/call/storage.rs
added_by: developer
test: cargo test -j2 -p voicen-core --lib call::storage::tests::export_
--- old
    let written = synced.and_then(|()| fs::rename(tmp, target));
--- new
    let written = synced.map(|()| {
        let _ = fs::rename(tmp, target);
    });
--- end
