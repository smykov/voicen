guarantee: AC-3: a root refusal leaves no track open
file: crates/voicen-core/src/call/session.rs
added_by: test-writer
--- old
                    Err(refusal) => {
                        opened.stop();
                        return Err(refusal);
--- new
                    Err(refusal) => {
                        std::mem::forget(opened.mic);
                        stop_handle(opened.system);
                        return Err(refusal);
--- end
