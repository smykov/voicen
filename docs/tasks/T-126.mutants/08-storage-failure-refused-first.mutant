guarantee: #243 D2: call_storage_failed comes before call_refused
file: crates/voicen-core/src/call/session.rs
added_by: test-writer
--- old
                            .write(LogEvent::CallStorageFailed { kind, os: None });
                        RefusedReason::Other
--- new
                            .write(LogEvent::CallRefused {
                                part: RefusedPart::Root,
                                reason: RefusedReason::Other,
                            });
                        self.deps
                            .log
                            .write(LogEvent::CallStorageFailed { kind, os: None });
                        RefusedReason::Other
--- end
