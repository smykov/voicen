--- new
        if false && self.load.unavailable {
            return Err(WarnedHostFailed);
        }
        let _guard = self
            .save_lock
            .lock()
            .unwrap_or_else(PoisonError::into_inner);
        let current = self.snapshot();
        if current
            .calls
            .warned_hosts
