guarantee: AC-2: every message show sets is offered to the Notifier exactly once, outside the session lock (drain missing at notice_with)
file: crates/voicen-core/src/dictation.rs
added_by: test-writer
--- old
        let mut st = self.shared.lock();
        st.ctrl.notice_with(id, params, at);
--- new
        let mut st = lock(&self.shared.state);
        st.ctrl.notice_with(id, params, at);
--- end
