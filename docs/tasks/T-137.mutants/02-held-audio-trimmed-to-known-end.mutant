guarantee: FR-018 invariant: held audio is exactly the carry [base, known_end), the lead-in is kept
file: crates/voicen-core/src/call/final_pass.rs
added_by: test-writer
--- old
        let base = self.ranges.base.max(self.held_start_ms);
        let drop = ms_to_samples(base - self.held_start_ms).min(self.held.len());
--- new
        let base = self.ranges.known_end.max(self.held_start_ms);
        let drop = ms_to_samples(base - self.held_start_ms).min(self.held.len());
--- end
