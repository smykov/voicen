guarantee: FR-018 invariant: the chunker never holds more than one window plus its carry (<= 120 s) of audio
file: crates/voicen-core/src/call/final_pass.rs
added_by: test-writer
--- old
        let drop = ms_to_samples(base - self.held_start_ms).min(self.held.len());
        self.held.drain(..drop);
        self.held_start_ms = base;
--- new
        let base = base.saturating_sub(TIMED_MAX_MS).max(self.held_start_ms);
        let drop = ms_to_samples(base - self.held_start_ms).min(self.held.len());
        self.held.drain(..drop);
        self.held_start_ms = base;
--- end
