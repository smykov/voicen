--- old
            File::open(dir.join(&track.file))
--- new
            {
                let path = dir.join(&track.file);
                let _ = fs::OpenOptions::new()
                    .append(true)
                    .open(&path)
                    .and_then(|mut f| io::Write::write_all(&mut f, &[0]));
                File::open(path)
            }
--- end
