guarantee: AC-4: a truncated model -> Err(Unavailable) (verify_against, the size refusal turned into Ok)
file: crates/voicen-core/src/vad/silero_model.rs
added_by: test-writer
test: cargo test -j2 -p voicen-core --test silero_model
--- old
    if !meta.is_file() || meta.len() != pin.size_bytes {
        return Err(VadError::Unavailable);
    }
--- new
    if !meta.is_file() || meta.len() != pin.size_bytes {
        return Ok(());
    }
--- end
