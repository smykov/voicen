guarantee: AC-2: writes only refs/heads/wip/<ID> on origin
file: scripts/tw-wip-push
added_by: test-writer
--- old
git push --no-follow-tags --no-recurse-submodules origin "+$sha:refs/heads/wip/$id"
--- new
git push --no-follow-tags --no-recurse-submodules "$(git config remote.pushDefault || echo origin)" "+$sha:refs/heads/wip/$id"
--- end
