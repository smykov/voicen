guarantee: AC-2: failure branch: a foreign commit is refused and no ref moves
file: scripts/tw-wip-push
added_by: test-writer
--- old
[ -n "$base" ] || refuse "no main branch to find the fork point from"
--- new
[ -n "$base" ] || { git push --no-follow-tags origin "+$arg:refs/heads/wip/x"; exit 0; }
--- end
