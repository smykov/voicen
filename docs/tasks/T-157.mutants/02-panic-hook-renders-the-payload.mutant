guarantee: Acceptance 1 / (P): a panic payload (the call's transcript) is never written into a crash file
file: crates/voicen-core/src/diag/crash.rs
added_by: test-writer
--- old
        write_panic(&ctx, location);
--- new
        write_panic(&ctx, location);
        let payload = info.payload();
        let text = payload
            .downcast_ref::<&str>()
            .map(|s| (*s).to_string())
            .or_else(|| payload.downcast_ref::<String>().cloned())
            .unwrap_or_default();
        if let Ok(entries) = std::fs::read_dir(&ctx.logs_dir) {
            for entry in entries.flatten() {
                let path = entry.path();
                if path.extension().is_some_and(|x| x == "txt") {
                    if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(&path) {
                        let _ = std::io::Write::write_all(&mut file, text.as_bytes());
                    }
                }
            }
        }
--- end
