guarantee: AC-2 / failure branch: a state built with the settings language mid-call (dismiss_warning) fails a core test
file: crates/voicen-core/src/call/session.rs
added_by: test-writer
--- old
        if !call.warnings.dismiss(id) {
            return false;
        }
        self.deps.indicator.set_state(&call.state());
--- new
        if !call.warnings.dismiss(id) {
            return false;
        }
        let lang = self.deps.settings.snapshot().ui_language;
        self.deps.indicator.set_state(&IndicatorState::recording(
            lang,
            call.reminder_until.is_some(),
            call.warnings.items(lang),
        ));
--- end
