guarantee: AC-2: A fails -> B still delivered (a failed job does not halt the queue)
file: crates/voicen-core/src/dictation.rs
added_by: test-writer
--- old
            Done::Recording(id, report) => {
                st.ctrl
                    .job_finished_pending(id, report.end, report.pending, now)
            }
--- new
            Done::Recording(id, report) => {
                let failed = matches!(report.end, crate::recording::JobEnd::Failed(_));
                st.ctrl
                    .job_finished_pending(id, report.end, report.pending, now);
                if failed {
                    return;
                }
            }
--- end
