--- new
    let mut stack: Vec<Job> = Vec::new();
    while let Some(job) = {
        if stack.is_empty() {
            if let Ok(first) = jobs.recv() {
                stack.push(first);
            }
        }
        stack.extend(jobs.try_iter());
        stack.pop()
    } {
--- end
