--- new
    pub fn folder(&self, calls: &CallSettings, root: &str, id: &str) -> Result<PathBuf, CallError> {
        let (root, id) = match guard(calls, &self.roots.default_root(), root, id) {
            Ok(v) => v,
            Err(_) => {
                let dir = PathBuf::from(root).join(id);
                return if dir.is_dir() { Ok(dir) } else { Err(CallError::not_found()) };
            }
        };
--- end
