        }
        fn lost(
            &self,
            _: voicen_core::call::Track,
            _: voicen_core::call::LossCause,
            _: voicen_core::call::CaptureStamp,
        ) {
        }
    }
    if let Ok((handle, _)) = voicen_core::call::TrackSource::open(
        &*source,
        voicen_core::call::Track::Mic,
        voicen_core::call::TrackDevice::DefaultInput,
        Arc::new(NullSink),
    ) {
        std::mem::forget(handle);
