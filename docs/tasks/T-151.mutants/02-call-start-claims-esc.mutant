guarantee: AC-3: Esc without a dictation reaches the focused app (a call start takes no Esc claim)
file: src-tauri/src/dictation.rs
added_by: test-writer
--- old
    hotkey.register_call(
        &call_hotkey,
        CallPort {
            on_press: Box::new(move || {
                call::request(&press_app, CallRequest::Record(CallSource::Hotkey));
--- new
    let press_cancel = cancel_key.clone();
    hotkey.register_call(
        &call_hotkey,
        CallPort {
            on_press: Box::new(move || {
                voicen_core::platform::CancelKey::set(&*press_cancel, true);
                call::request(&press_app, CallRequest::Record(CallSource::Hotkey));
--- end
