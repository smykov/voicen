guarantee: AC-2: a character outside {, }, ., hex, - formats as endpoint=invalid
file: crates/voicen-core/src/call/events.rs
added_by: test-writer
--- old
                .all(|c| c.is_ascii_hexdigit() || matches!(c, '{' | '}' | '.' | '-'));
--- new
                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '{' | '}' | '.' | '-'));
--- end
