#!/usr/bin/env bash
# commit-msg — git hook (installed by scripts/install-hooks.sh via core.hooksPath).
#
# Runs at commit-msg on purpose: both the staged diff AND the message are visible,
# so a deliberate override written into the message (RCA / Principle-Override
# trailer) can be accepted and stays in history.
#
#   1. patch-guard.sh  — "patch instead of root cause" check (may block).
#   2. status-commit convention — warns when a commit changes a task status in
#      docs/tasks/ but no message line reads `chore(task): <ID> <FROM>→<TO>`
#      (process metrics parse these subjects).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MSG_FILE="${1:-}"

bash "$HERE/patch-guard.sh" "$MSG_FILE" || exit 1

if [ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ]; then
  # templates (docs/tasks/_*.md) are not tasks; a new task has no FROM: `T-001 →TODO`
  if git diff --cached --unified=0 -- 'docs/tasks/*.md' ':(exclude)docs/tasks/_*' 2>/dev/null |
      grep -qE '^\+status:'; then
    if ! grep -v '^#' "$MSG_FILE" | grep -qE '^chore\(task\): [A-Z][A-Z0-9]*-[0-9]+ [A-Z_]*(→|->)[A-Z_]+'; then
      echo "commit-msg: note - task status changed; preferred subject:" >&2
      echo "  chore(task): T-042 NEEDS_REVIEW→CODE_COMPLETE" >&2
    fi
  fi
fi
exit 0
