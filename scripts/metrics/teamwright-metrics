def parse_args(argv):
    p = argparse.ArgumentParser(prog="teamwright-metrics", description=__doc__.split("\n")[0],
                                epilog="See docs/process/metrics.md.")
    a = p.add_argument
    a("--repo", help="repository path (default .)")
    a("--rev", help="revision to read history and records from (default HEAD)")
    a("--config", help="JSON options file (default <repo>/.teamwright/metrics.json if present)")
    a("--since", help="YYYY-MM-DD, inclusive")
    a("--until", help="YYYY-MM-DD, inclusive")
    a("--split-date", help="YYYY-MM-DD: report before / after this day and the delta")
    a("--merges", action="store_true", default=None, help="count merge commits too")
    a("--agent", action="append", help="agent family label=regex (repeatable; replaces defaults)")
    a("--model-alias", action="append", help="regex=name to normalize co-author names (repeatable)")
    a("--fix-regex", help="subject regex for fix commits (case-insensitive)")
    a("--revert-regex", help="subject regex for revert commits")
    a("--exclude-regex", help="paths ignored for areas, churn and recurrence ('' = none)")
    a("--area", choices=["dir", "file"], help="area granularity (default file)")
    a("--area-depth", type=int, help="with --area dir: truncate to N components (0 = full)")
    a("--version-bump-regex", help="manifests whose +1 -1 changes are version bumps, not areas "
                                   "('' = none)")
    a("--ledger-regex", help="subject regex of task-transition commits, left out of the git "
                             "shares and used for parse coverage ('' = none)")
    a("--refix-days", type=int, help="days between a task's first and last fix commit that make "
                                     "it 'fixed again' (2)")
    a("--refix-ids", choices=["all", "single"], help="credit a fix commit to every task id in "
      "its subject (all, default) or only to commits naming one id (single)")
    a("--trailer-break-ratio", type=float, help="a week is a trailer-coverage drop below this "
                                                 "x baseline agent share (0.5)")
    a("--trailer-min-commits", type=int, help="work commits a week needs to enter trailer-break "
                                              "detection (10)")
    a("--min-fixes", type=int, help="fix commits in --window days that make an area recurring (3)")
    a("--window", type=int, help="window in days for recurring areas (30)")
    a("--recurrence-days", type=int, help="look-back in days for the recurrence rate (30)")
    a("--top", type=int, help="rows in top lists (10)")
    a("--transition-regex", help="regex with groups ids|id, to, optional from; <ID> expands to "
                                 "--task-id-regex")
    a("--task-id-regex", help="task id regex (default %s)" % DEFAULT_TASK_ID_RE)
    a("--status-aliases", help="JSON {alias: STATUS} or lines ALIAS=STATUS")
    a("--tasks-dir", help="task records directory (default docs/tasks)")
    a("--sprint-regex", help="regex over transition commits; group 1 = sprint label")
    a("--sprint-from-id", help="regex over the task id; group 1 = sprint label (e.g. "
                               "'^S(\\d+)-' makes S4-12 sprint 4)")
    a("--task-period", choices=["end", "start"], help="period a task belongs to: its last DONE "
                                                      "(end, default) or its start (cohort)")
    a("--logs", action="append", help="journal file or directory (repeatable; default "
                                      "<repo>/.teamwright/logs)")
    a("--reviewer-agent-regex", help="subagent/agent type that counts as a reviewer")
    a("--review-claim-field", action="append", help="record field that claims a review (repeatable)")
    a("--review-claim-regex", help="claim-field string values that count as a claim "
                                   "(default %s)" % DEFAULT_CLAIM_VALUE_RE)
    a("--claim-join", choices=["auto", "session", "time"], help="how claim/outcome records "
      "find their session: by session id, or by time for journals without one (auto)")
    a("--claim-window", type=int, help="minutes for --claim-join time (10)")
    a("--json", action="store_true", default=None, help="print JSON instead of Markdown")
    a("--output", "-o", help="write to a file instead of stdout")
    a("--debug", action="store_true", default=None, help="add a sample of unparsed ledger "
                                                          "subjects to the report")
    a("--debug-sample", type=int, help="size of that sample (20)")
    ns = p.parse_args(argv)
    repo = ns.repo or "."
    cfg_path = ns.config or os.path.join(repo, ".teamwright", "metrics.json")
    cfg = {}
    if ns.config or os.path.isfile(cfg_path):
        try:
            cfg = json.load(open(cfg_path, encoding="utf-8"))
        except (OSError, ValueError) as e:
            die("cannot read config %s: %s" % (os.path.basename(cfg_path), e))
        unknown = set(cfg) - set(DEFAULTS)
        if unknown:
            die("unknown config keys: %s" % ", ".join(sorted(unknown)))
    for k, dv in DEFAULTS.items():
        v = getattr(ns, k, None)
        if v is None:
            v = cfg.get(k, dv)
        if isinstance(dv, list) and isinstance(v, str):
            v = [v]
        setattr(ns, k, v)
    ns.since_dt = parse_day(ns.since, "--since")
    ns.until_dt = parse_day(ns.until, "--until")
    if ns.until_dt:
        ns.until_dt += dt.timedelta(days=1)       # inclusive day
    ns.split_dt = parse_day(ns.split_date, "--split-date")
    for k in ("fix_regex", "revert_regex", "exclude_regex", "task_id_regex", "sprint_regex",
              "reviewer_agent_regex", "ledger_regex", "version_bump_regex", "sprint_from_id", "review_claim_regex"):
        try:
            re.compile(getattr(ns, k) or "")
        except re.error as e:
            die("--%s does not compile: %s" % (k.replace("_", "-"), e))
    return ns


def main(argv=None):
    opt = parse_args(sys.argv[1:] if argv is None else argv)
    if git(opt.repo, "rev-parse", "--git-dir", check=False) is None:
        die("%s is not a git repository" % opt.repo)
    if opt.split_dt:
        periods = [("before", opt.since_dt, opt.split_dt), ("after", opt.split_dt, opt.until_dt)]
    else:
        periods = [("all", opt.since_dt, opt.until_dt)]
    top = (git(opt.repo, "rev-parse", "--show-toplevel", check=False) or opt.repo).strip()
    g = git_section(opt, periods)
    commits = g.pop("_commits", None)
    t = task_section(opt, periods, commits)
    tasks = t.pop("_tasks", None)
    j = journal_section(opt, periods, tasks)
    rep = {
        "repo": os.path.basename(os.path.abspath(top)),
        "generated": dt.datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "params": {"since": opt.since, "until": opt.until, "split_date": opt.split_date,
                   "rev": opt.rev, "top": opt.top},
        "periods": [{"name": n, "from": a.strftime("%Y-%m-%d") if a else None,
                     "to_exclusive": b.strftime("%Y-%m-%d") if b else None} for n, a, b in periods],
        "git": g, "tasks": t, "journal": j,
    }
    text = (json.dumps(rep, indent=2, ensure_ascii=False, default=str) + "\n") if opt.json \
        else render_md(rep, periods)
    if opt.output:
        with open(opt.output, "w", encoding="utf-8") as fh:
            fh.write(text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
