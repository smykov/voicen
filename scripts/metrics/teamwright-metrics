#!/usr/bin/env python3
"""teamwright-metrics - process metrics from git history and hook journals.

Principle: every number comes from something the agents cannot edit after the fact
(commits, task-transition commits, review records in git, hook journals). Nothing
is taken from an agent's report. Each number is printed with its source and n; a
missing source prints "no data", never 0.

Usage (from the repository root, or with --repo):

    teamwright-metrics                          Markdown report for the whole history
    teamwright-metrics --json                   same data as JSON
    teamwright-metrics --since 2026-01-01 --until 2026-06-30
    teamwright-metrics --split-date 2026-04-01  every metric before / after + delta
    teamwright-metrics --transition-regex '^\\s*status:\\s*(?P<ids><ID>)\\s+(?P<from>\\w+)\\s*->\\s*(?P<to>\\w+)'
    teamwright-metrics --status-aliases aliases.json --logs old-logs/
    teamwright-metrics --task-id-regex 'S\\d+-\\d+' --sprint-from-id '^S(\\d+)-' --debug

Sources:
  1. git log                -> commits, agent co-authorship, fixes, reverts, recurrence
  2. task-transition lines  -> cycle time, rework, review rounds, escalations
     (default `chore(task): T-042 NEEDS_REVIEW→CODE_COMPLETE`, parsed tolerantly:
     several ids, `->`, missing from, words around; parse coverage is reported)
     plus docs/tasks/<ID>.md and docs/tasks/<ID>.reviews/<n>.md as committed in git
  3. .teamwright/logs/*.jsonl (journal.sh) -> outcomes, declared vs actual review,
     permission denials, tool calls per session

Options may also come from a JSON file (--config, or .teamwright/metrics.json in the
repository): keys are the long option names with underscores. Command-line wins.
See docs/process/metrics.md for what each metric means and its known biases.
Python 3 standard library only.
"""
import argparse
import bisect
import datetime as dt
import json
import os
import re
import subprocess
import sys
from collections import Counter, defaultdict

NO_DATA = "no data"
UTC = dt.timezone.utc

# ---------------------------------------------------------------- defaults

DEFAULT_FIX_RE = r"^(fix|bugfix|hotfix)(\(|:|!)|\bfix(es|ed)?\b"   # same as patch-guard
DEFAULT_REVERT_RE = r"^revert\b"
# Paths that count for nothing in areas, churn and recurrence: task records, docs and
# planning files (any Markdown/reStructuredText/AsciiDoc: SPRINT.md, TODO.md, ...) and
# lockfiles. A fix that touches only these has no area and is left out of recurrence.
DEFAULT_EXCLUDE_RE = (r"^docs/|(^|/)[^/]*\.(md|mdx|markdown|rst|adoc)$|"
                      r"(^|/)(package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.yaml|"
                      r"bun\.lockb?|poetry\.lock|uv\.lock|Pipfile\.lock|Cargo\.lock|go\.sum|"
                      r"composer\.lock|Gemfile\.lock|mix\.lock|pubspec\.lock|packages\.lock\.json)$")
# A one-line change (+1 -1) to a package manifest is a version bump that rides along with
# every change (release tooling, per-service versions): it is not an area of the fix.
DEFAULT_VERSION_BUMP_RE = (r"(^|/)(package\.json|pyproject\.toml|Cargo\.toml|setup\.cfg|"
                           r"pubspec\.yaml|Chart\.yaml|composer\.json|[^/]*\.csproj|"
                           r"[^/]*\.gemspec|VERSION|version\.txt)$")
DEFAULT_TASK_ID_RE = r"[A-Z][A-Z0-9]*-\d+"
# Default transition parser, tolerant of hand-written ledger subjects. <ID> expands to
# --task-id-regex. Matches anywhere in a line (subject or body), any number per line:
#   T-42 NEEDS_REVIEW→CODE_COMPLETE      T-1, T-2 TODO -> IN_PROGRESS
#   REVIEW T-7 NEEDS_REVIEW → DONE      T-9 → NEEDS_REVIEW (no from)    T-3 wip -> done
# Named groups: ids (one or more ids), to, optional from. Arrows: → -> =>.
# Upper-case statuses of 3+ letters are always accepted; other spellings only when they
# normalize (via --status-aliases) to a known status, so "T-1 foo -> bar" is not a transition.
DEFAULT_TRANSITION_RE = (r"(?<![\w-])(?P<ids><ID>(?:[ \t]*(?:[,&+/]|\band\b)?[ \t]*<ID>)*)"
                         r"[ \t]*:?[ \t]*(?:(?P<from>[A-Za-z][A-Za-z_]*)[ \t]*)?"
                         r"(?:→|->|=>)[ \t]*(?P<to>[A-Za-z][A-Za-z_]*)\b")
# Subjects of task-transition ("ledger") commits: chore(task):, docs(sprint3):, ...
# They are the candidates for parse coverage and are left out of the git shares.
DEFAULT_LEDGER_RE = r"^\w+\((?:tasks?|sprint)\w*\)!?:"
KNOWN_STATUSES = {"TODO", "ANALYSIS", "IN_PROGRESS", "NEEDS_REVIEW", "CODE_COMPLETE", "DEPLOYED",
                  "VERIFY", "VERIFIED", "VERIFY_FAIL", "DONE", "BLOCKED", "DEFERRED"}
# Agent families: label=regex, matched case-insensitively against the whole
# Co-Authored-By value (name and e-mail). Written to avoid humans named Claude/Devin.
DEFAULT_AGENTS = [
    "claude=anthropic|\\bclaude\\b[\\s-]*(code|opus|sonnet|haiku|fable|instant|\\d)",
    "copilot=copilot",
    "cursor=cursoragent|cursor agent|@cursor\\.(com|sh)",
    "codex=\\bcodex\\b|openai|chatgpt",
    "gemini=gemini|google-labs-jules",
    "devin=devin-ai|devin\\[bot\\]|\\bdevin ai\\b",
    "aider=\\baider\\b",
    "junie=\\bjunie\\b",
]
DEFAULT_REVIEWER_RE = r"^code-reviewer$"
DEFAULT_CLAIM_FIELDS = ["review_claimed", "claimed_review", "reviewed", "review_done"]
# A claim-field value that claims a review: boolean true / 1, or a string matching this.
DEFAULT_CLAIM_VALUE_RE = r"^(true|yes|y|1)$|\breviewer\b"

START = {"ANALYSIS", "IN_PROGRESS"}
LATE = {"NEEDS_REVIEW", "CODE_COMPLETE", "DEPLOYED", "VERIFIED", "VERIFY_FAIL"}
REWORK_FROM = {"NEEDS_REVIEW", "CODE_COMPLETE", "DEPLOYED", "VERIFIED", "VERIFY_FAIL", "VERIFY"}
REWORK_TO = {"IN_PROGRESS", "ANALYSIS"}


# ---------------------------------------------------------------- helpers

def die(msg, code=2):
    print("teamwright-metrics: " + msg, file=sys.stderr)
    sys.exit(code)


def parse_day(s, name):
    if not s:
        return None
    try:
        return dt.datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=UTC)
    except ValueError:
        die("%s must be YYYY-MM-DD, got %r" % (name, s))


def parse_ts(v):
    """ISO-8601 string or epoch seconds/milliseconds -> aware UTC datetime, or None."""
    if v is None or v == "":
        return None
    if isinstance(v, (int, float)):
        x = float(v)
        if x > 1e11:
            x /= 1000.0
        try:
            return dt.datetime.fromtimestamp(x, UTC)
        except (OverflowError, OSError, ValueError):
            return None
    s = str(v).strip()
    if re.fullmatch(r"\d+(\.\d+)?", s):
        return parse_ts(float(s))
    s = s.replace("Z", "+00:00").replace(" ", "T", 1)
    s = re.sub(r"(\.\d{6})\d+", r"\1", s)
    try:
        d = dt.datetime.fromisoformat(s)
    except ValueError:
        return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=UTC)
    return d.astimezone(UTC)


def month(d):
    return d.strftime("%Y-%m")


def quantile(values, q):
    """Linear-interpolated quantile (q in 0..1) of a non-empty list."""
    xs = sorted(values)
    if not xs:
        return None
    pos = (len(xs) - 1) * q
    lo = int(pos)
    hi = min(lo + 1, len(xs) - 1)
    return xs[lo] + (xs[hi] - xs[lo]) * (pos - lo)


def days_between(a, b):
    return (b - a).total_seconds() / 86400.0


# A metric value: always carries its n and source. value None means "no data".
def share(num, den, source):
    return {"kind": "share", "value": (num / den) if den else None,
            "num": num, "n": den, "source": source}


def count(v, source, n=None):
    return {"kind": "count", "value": v, "n": n, "source": source}


def number(v, n, source, kind="number"):
    return {"kind": kind, "value": v, "n": n, "source": source}


def nodata(source, kind="count", reason=None):
    d = {"kind": kind, "value": None, "n": 0, "source": source}
    if reason:
        d["reason"] = reason
    return d


def load_aliases(path):
    if not path:
        return {}
    try:
        text = open(path, encoding="utf-8").read()
    except OSError as e:
        die("cannot read status aliases: %s" % e)
    try:
        data = json.loads(text)
        if not isinstance(data, dict):
            raise ValueError
    except ValueError:
        data = {}
        for line in text.splitlines():
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                data[k.strip()] = v.strip()
    return {norm_status(k): norm_status(v) for k, v in data.items()}


def norm_status(s):
    return re.sub(r"[\s-]+", "_", (s or "").strip()).upper()


# ---------------------------------------------------------------- git source

def git(repo, *args, check=True):
    try:
        p = subprocess.run(["git", "-C", repo] + list(args), stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE)
    except OSError as e:
        die("git not available: %s" % e)
    if check and p.returncode != 0:
        die("git %s failed: %s" % (" ".join(args[:2]),
                                   p.stderr.decode("utf-8", "replace").strip()))
    return p.stdout.decode("utf-8", "replace") if p.returncode == 0 else None


def load_commits(opt):
    fmt = "%x1e%H%x1f%aI%x1f%P%x1f%B%x1f"
    args = ["log", "--numstat", "--no-renames", "--format=" + fmt]
    if not opt.merges:
        args.append("--no-merges")
    if opt.until:
        args.append("--until=" + (opt.until_dt + dt.timedelta(seconds=-1)).isoformat())
    args.append(opt.rev)
    out = git(opt.repo, *args, check=False)
    if out is None:
        return None
    commits = []
    for chunk in out.split("\x1e"):
        if not chunk.strip():
            continue
        parts = chunk.split("\x1f", 4)
        if len(parts) < 5:
            continue
        sha, date, parents, body, rest = parts
        d = parse_ts(date)
        if d is None:
            continue
        files = []
        for line in rest.splitlines():
            f = line.split("\t", 2)
            if len(f) == 3:
                a = int(f[0]) if f[0].isdigit() else 0
                r = int(f[1]) if f[1].isdigit() else 0
                files.append((f[2], a, r))
        body = body.strip("\n")
        commits.append({"sha": sha, "date": d, "month": month(d), "body": body,
                        "subject": body.split("\n", 1)[0], "merge": len(parents.split()) > 1,
                        "files": files})
    commits.reverse()                  # git log is newest first: ties keep commit order
    commits.sort(key=lambda c: c["date"])
    return commits


def normalize_model(name, aliases):
    for rx, label in aliases:
        if rx.search(name):
            return label
    s = name.lower()
    s = re.sub(r"<[^>]*>", " ", s)
    s = re.sub(r"\([^)]*\)|\[[^\]]*\]", " ", s)
    s = re.sub(r"[-_/,:]", " ", s)
    toks = [t for t in s.split()
            if not re.fullmatch(r"v?\d+(\.\d+)*[a-z]?|\d{6,8}|latest|preview|noreply|bot", t)]
    return " ".join(toks) or name.strip().lower()


def classify_commits(commits, opt):
    agents = []
    for spec in opt.agent:
        if "=" not in spec:
            die("--agent expects label=regex, got %r" % spec)
        label, rx = spec.split("=", 1)
        agents.append((label.strip(), re.compile(rx, re.I)))
    aliases = []
    for spec in opt.model_alias:
        if "=" not in spec:
            die("--model-alias expects regex=name, got %r" % spec)
        rx, label = spec.rsplit("=", 1)
        aliases.append((re.compile(rx, re.I), label.strip()))
    fix_re = re.compile(opt.fix_regex, re.I)
    rev_re = re.compile(opt.revert_regex, re.I)
    excl = re.compile(opt.exclude_regex) if opt.exclude_regex else None
    bump = re.compile(opt.version_bump_regex) if opt.version_bump_regex else None
    ledger = re.compile(opt.ledger_regex, re.I) if opt.ledger_regex else None
    id_rx = re.compile(opt.task_id_regex)
    trailer = re.compile(r"(?im)^[ \t]*co-authored-by:[ \t]*(.+?)[ \t]*$")
    for c in commits:
        c["ledger"] = bool(ledger and ledger.search(c["subject"]))
        c["agents"], c["models"] = [], []
        for val in trailer.findall(c["body"]):
            for label, rx in agents:
                if rx.search(val):
                    c["agents"].append(label)
                    c["models"].append(normalize_model(val, aliases))
                    break
        c["revert"] = bool(rev_re.search(c["subject"])) or "This reverts commit" in c["body"]
        c["fix"] = (not c["revert"]) and (not c["ledger"]) and bool(fix_re.search(c["subject"]))
        ids = {m.group(0) for m in id_rx.finditer(c["subject"])} if c["fix"] else set()
        if opt.refix_ids == "single" and len(ids) != 1:
            ids = set()                    # only unambiguous one-task fix commits
        c["fix_tasks"] = ids
        c["areas"] = set()
        c["area_churn"] = Counter()
        for path, a, r in c["files"]:
            if excl and excl.search(path):
                continue
            if bump and a == 1 and r == 1 and bump.search(path):
                continue
            ar = area_of(path, opt)
            c["areas"].add(ar)
            c["area_churn"][ar] += a + r
    # recurrence over the whole loaded history (so the look-back reaches before --since)
    last_fix = {}
    look = dt.timedelta(days=opt.recurrence_days)
    for c in commits:
        if not c["fix"]:
            continue
        if not c["areas"]:
            c["recurrent"] = None
            continue
        c["recurrent"] = any(a in last_fix and c["date"] - last_fix[a] <= look
                             for a in c["areas"])
        for a in c["areas"]:
            last_fix[a] = c["date"]


def area_of(path, opt):
    if opt.area == "file":
        return path
    d = os.path.dirname(path)
    if not d:
        return path            # a root-level file is its own area, never "."
    if opt.area_depth:
        d = "/".join(d.split("/")[:opt.area_depth])
    return d


def git_period_summary(cs, opt, src, breaks):
    n = len(cs)
    work = [c for c in cs if not c["ledger"]]          # shares exclude ledger commits
    w = len(work)
    months = sorted({c["month"] for c in cs})
    fixes = [c for c in work if c["fix"]]
    rec = [c for c in fixes if c.get("recurrent") is not None]
    wsrc = src + ", ledger commits excluded"
    agent = share(sum(1 for c in work if c["agents"]), w,
                  wsrc + " - Co-Authored-By matching an agent pattern")
    covered = [c for c in work if not in_breaks(c["date"], breaks)]
    if len(covered) < w:
        # a trailer-coverage break falls in this period: the share mixes weeks where agents
        # signed their commits with weeks where nobody did, so its level means nothing
        agent = dict(agent, raw_value=agent["value"], value=None, unreliable=True,
                     reason="trailer-coverage break in this period (%d of %d commits)" % (
                         w - len(covered), w))
    out = {
        "commits": count(n, src, n),
        "ledger_commits": count(n - w, src + " - subject matches --ledger-regex", n),
        "active_months": count(len(months), src, n),
        "commits_per_active_month": number(round(n / len(months), 1) if months else None,
                                           len(months), src),
        "agent_coauthored_share": agent,
        "fix_share": share(len(fixes), w, wsrc + " - subject matches --fix-regex"),
        "revert_share": share(sum(1 for c in work if c["revert"]), w, wsrc + " - revert commits"),
        "recurrence_rate": share(sum(1 for c in rec if c["recurrent"]), len(rec),
                                 src + " - fix commits touching an area fixed in the previous "
                                 "%d days" % opt.recurrence_days),
        "recurring_areas": count(len(recurring_areas(cs, opt)), src + " - areas with >= %d fixes "
                                 "within %d days" % (opt.min_fixes, opt.window), len(fixes)),
        "tasks_fixed_again": refix_share(fixes, opt, src),
    }
    if breaks:
        out["agent_coauthored_share_covered"] = share(
            sum(1 for c in covered if c["agents"]), len(covered),
            wsrc + " - weeks outside trailer-coverage breaks only")
    if not n:
        for k in out:
            out[k]["value"] = None
    return out


def refix_share(fixes, opt, src):
    """Tasks whose fix commits (subject naming the task id; --refix-ids single: naming only
    that id) fall on days at least --refix-days apart: the task-level "patched again"
    signal, independent of files and area granularity."""
    days = defaultdict(set)
    for c in fixes:
        for tid in c["fix_tasks"]:
            days[tid].add(c["date"].date())
    again = sum(1 for ds in days.values() if (max(ds) - min(ds)).days >= opt.refix_days)
    return share(again, len(days), src + " - tasks named in fix subjects%s, fixed on days "
                 ">= %d apart (of tasks with a fix)" % (
                     " (alone)" if opt.refix_ids == "single" else "", opt.refix_days))


def in_breaks(d, breaks):
    return any(a <= d < b for a, b in breaks)


def trailer_breaks(commits, opt):
    """Detect weeks where agents stopped signing commits (a settings change, a squash
    policy), so the agent share falls without the work changing. Per ISO week (weeks with
    >= --trailer-min-commits work commits), a week is low when its trailer share is below
    --trailer-break-ratio x the median of the previous 4 non-low weeks (baseline >= 30%).
    Two consecutive low weeks - or low weeks up to the end of history - form a break; it
    ends at the first week that recovers. Returns [(start, end_exclusive, info)]."""
    weeks = defaultdict(lambda: [0, 0])
    for c in commits:
        if c["ledger"]:
            continue
        y, wk, _ = c["date"].isocalendar()
        weeks[(y, wk)][0] += 1
        weeks[(y, wk)][1] += 1 if c["agents"] else 0
    keys = [k for k in sorted(weeks) if weeks[k][0] >= opt.trailer_min_commits]
    base_hist, low = [], {}
    for k in keys:
        n, a = weeks[k]
        sh = a / n
        base = quantile(base_hist[-4:], .5) if base_hist else None
        if base is not None and base >= 0.3 and sh < opt.trailer_break_ratio * base:
            low[k] = (sh, base, n)
        else:
            base_hist.append(sh)
    runs, cur = [], []
    for k in keys:
        if k in low:
            cur.append(k)
        else:
            if len(cur) >= 2:
                runs.append((cur, False))
            cur = []
    if cur:
        runs.append((cur, True))
    out = []
    for run, to_end in runs:
        start = dt.datetime.fromisocalendar(run[0][0], run[0][1], 1).replace(tzinfo=UTC)
        end = (dt.datetime.fromisocalendar(run[-1][0], run[-1][1], 1).replace(tzinfo=UTC)
               + dt.timedelta(days=7))
        if to_end:
            end = dt.datetime.max.replace(tzinfo=UTC)
        out.append((start, end, {
            "from": start.strftime("%Y-%m-%d"),
            "to": None if to_end else (end - dt.timedelta(days=1)).strftime("%Y-%m-%d"),
            "weeks": len(run), "baseline_share": round(low[run[0]][1], 3),
            "share_in_break": round(sum(weeks[k][1] for k in run) / sum(weeks[k][0] for k in run), 3),
            "commits_in_low_weeks": sum(weeks[k][0] for k in run)}))
    return out


def recurring_areas(cs, opt):
    by_area = defaultdict(list)
    for c in cs:
        if c["fix"]:
            for a in c["areas"]:
                by_area[a].append(c["date"])
    res = []
    win = dt.timedelta(days=opt.window)
    for a, ds in by_area.items():
        ds.sort()
        best, j = 0, 0
        best_span = (ds[0], ds[0])
        for i in range(len(ds)):
            while ds[i] - ds[j] > win:
                j += 1
            if i - j + 1 > best:
                best, best_span = i - j + 1, (ds[j], ds[i])
        if best >= opt.min_fixes:
            res.append({"area": a, "fixes_in_window": best, "fixes_total": len(ds),
                        "window_start": best_span[0].strftime("%Y-%m-%d"),
                        "window_end": best_span[1].strftime("%Y-%m-%d")})
    res.sort(key=lambda r: (-r["fixes_in_window"], -r["fixes_total"], r["area"]))
    return res


def hotspots(cs, opt):
    churn, fixes, commits = Counter(), Counter(), Counter()
    for c in cs:
        for a, v in c["area_churn"].items():
            churn[a] += v
            commits[a] += 1
        if c["fix"]:
            for a in c["areas"]:
                fixes[a] += 1
    rows = [{"area": a, "churn": churn[a], "fixes": fixes[a], "commits": commits[a],
             "score": churn[a] * fixes[a]} for a in fixes]
    rows.sort(key=lambda r: (-r["score"], -r["fixes"], r["area"]))
    return rows[:opt.top]


def git_section(opt, periods):
    commits = load_commits(opt)
    src = "git log %s%s" % (opt.rev, "" if opt.merges else " --no-merges")
    if commits is None:
        return {"status": NO_DATA, "reason": "not a git repository or no commits", "source": src}
    classify_commits(commits, opt)
    brk = trailer_breaks(commits, opt)
    breaks = [(a, b) for a, b, _ in brk]
    in_range = [c for c in commits if in_period(c["date"], opt.since_dt, opt.until_dt)]
    if not in_range:
        return {"status": NO_DATA, "reason": "no commits in the selected range", "source": src,
                "_commits": commits}
    monthly = []
    by_month = defaultdict(list)
    for c in in_range:
        by_month[c["month"]].append(c)
    for m in sorted(by_month):
        cs = by_month[m]
        work = [c for c in cs if not c["ledger"]]
        fixes = [c for c in work if c["fix"]]
        rec = [c for c in fixes if c.get("recurrent") is not None]
        monthly.append({
            "month": m, "commits": len(cs), "work_commits": len(work),
            "agent_coauthored": sum(1 for c in work if c["agents"]),
            "trailer_break": any(in_breaks(c["date"], breaks) for c in work),
            "fixes": len(fixes), "reverts": sum(1 for c in work if c["revert"]),
            "recurrent_fixes": sum(1 for c in rec if c["recurrent"]),
            "fixes_with_area": len(rec),
        })
    fam, models = Counter(), Counter()
    for c in in_range:
        for a in set(c["agents"]):
            fam[a] += 1
        for mo in set(c["models"]):
            models[mo] += 1
    summary = {}
    for name, a, b in periods:
        cs = [c for c in in_range if in_period(c["date"], a, b)]
        summary[name] = git_period_summary(cs, opt, src, breaks)
    return {"source": src, "n_commits": len(in_range), "summary": summary, "monthly": monthly,
            "agent_families": dict(fam.most_common()), "agent_models": dict(models.most_common()),
            "trailer_breaks": [info for _, _, info in brk],
            "recurring_areas": recurring_areas(in_range, opt), "hotspots": hotspots(in_range, opt),
            "params": {"area": opt.area, "area_depth": opt.area_depth, "window_days": opt.window,
                       "min_fixes": opt.min_fixes, "recurrence_days": opt.recurrence_days,
                       "fix_regex": opt.fix_regex, "exclude_regex": opt.exclude_regex,
                       "version_bump_regex": opt.version_bump_regex,
                       "ledger_regex": opt.ledger_regex, "refix_days": opt.refix_days,
                       "refix_ids": opt.refix_ids,
                       "trailer_break_ratio": opt.trailer_break_ratio,
                       "trailer_min_commits": opt.trailer_min_commits},
            "_commits": commits}


def in_period(d, a, b):
    return (a is None or d >= a) and (b is None or d < b)


