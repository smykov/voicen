def iter_json(text):
    """Yield dict objects from JSONL, concatenated or pretty-printed JSON, or arrays."""
    dec = json.JSONDecoder()
    i, n, bad = 0, len(text), 0
    while i < n:
        while i < n and text[i] in " \t\r\n,":
            i += 1
        if i >= n:
            break
        try:
            obj, i = dec.raw_decode(text, i)
        except ValueError:
            bad += 1
            nl = text.find("\n", i)
            i = n if nl < 0 else nl + 1
            continue
        items = obj if isinstance(obj, list) else [obj]
        for o in items:
            if isinstance(o, dict):
                yield o
    if bad:
        yield {"__bad__": bad}


EVENT_ALIASES = {"pretooluse": "pre", "posttooluse": "post", "posttoolusefailure": "failure",
                 "permissiondenied": "PermissionDenied", "permissionrequest": "PermissionRequest",
                 "stop": "Stop", "subagentstop": "SubagentStop"}


def pick(rec, *keys):
    for k in keys:
        v = rec.get(k)
        if v not in (None, ""):
            return v
    return ""


def norm_record(r):
    ev = str(pick(r, "event", "hook_event_name", "type"))
    ev = EVENT_ALIASES.get(ev.lower(), ev)
    return {"ts": parse_ts(pick(r, "ts", "timestamp", "time")),
            "session": str(pick(r, "session_id", "sessionId", "session")),
            "agent_id": str(pick(r, "agent_id", "agentId")),
            "agent_type": str(pick(r, "agent_type", "agentType")),
            "tool": str(pick(r, "tool", "tool_name", "toolName")),
            "detail": str(pick(r, "detail")),
            "subagent_type": str(pick(r, "subagent_type", "subagentType")),
            "task_ids": r.get("task_ids") if isinstance(r.get("task_ids"), list) else [],
            "event": ev, "outcome": r.get("outcome"), "raw": r}


def load_journal(opt):
    paths = opt.logs or [os.path.join(opt.repo, ".teamwright", "logs")]
    files = []
    for p in paths:
        if os.path.isdir(p):
            files += sorted(os.path.join(p, f) for f in os.listdir(p)   # dotfiles = tool state
                            if f.endswith((".jsonl", ".json", ".ndjson")) and not f.startswith("."))
        elif os.path.isfile(p):
            files.append(p)
    recs, bad = [], 0
    for f in files:
        try:
            text = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        for o in iter_json(text):
            if "__bad__" in o:
                bad += o["__bad__"]
            else:
                recs.append(norm_record(o))
    return files, recs, bad


def claims_review(v, rx):
    if v is True or (isinstance(v, (int, float)) and not isinstance(v, bool) and v == 1):
        return True
    return isinstance(v, str) and bool(rx.search(v.strip()))


def join_claims_by_time(recs, opt):
    """Journals whose outcome/claim records carry no usable session id (a fixed label, or
    none) are attached to the tool-call session that ended nearest to the record, within
    --claim-window minutes. 'auto' does this only when no outcome/claim record shares a
    session id with any tool call and they carry at most one distinct session value (a
    fixed label or none). Returns the join mode actually used."""
    fields = set(opt.review_claim_field)
    tool_sess = defaultdict(list)
    for r in recs:
        if r["tool"] and r["session"] and r["ts"]:
            tool_sess[r["session"]].append(r["ts"])
    claimish = [r for r in recs if r["outcome"] is not None or fields & set(r["raw"])]
    if opt.claim_join == "session" or not claimish or not tool_sess:
        return "session"
    if opt.claim_join == "auto" and (any(r["session"] in tool_sess for r in claimish) or
                                     len({r["session"] for r in claimish if r["session"]}) > 1):
        return "session"
    ends = sorted((max(ts), s) for s, ts in tool_sess.items())
    keys = [e[0] for e in ends]
    win = dt.timedelta(minutes=opt.claim_window)
    for r in claimish:
        if r["session"] in tool_sess and opt.claim_join == "auto":
            continue
        r["session"] = ""
        if not r["ts"]:
            continue
        i = bisect.bisect_left(keys, r["ts"])
        best = None
        for j in (i - 1, i):
            if 0 <= j < len(ends) and abs(ends[j][0] - r["ts"]) <= win:
                if best is None or abs(ends[j][0] - r["ts"]) < abs(best[0] - r["ts"]):
                    best = ends[j]
        if best:
            r["session"] = best[1]
    return "time (+/- %d min of a tool session's last call)" % opt.claim_window


def journal_period_summary(recs, opt, tasks, src, typed_since=None):
    rv = re.compile(opt.reviewer_agent_regex, re.I)
    sessions = defaultdict(list)
    for r in recs:
        if r["session"]:
            sessions[r["session"]].append(r)
    n_s = len(sessions)
    has_pre = any(r["event"] == "pre" for r in recs)
    calls = [r for r in recs if (r["event"] == "pre" if has_pre else
                                 (r["tool"] and r["event"] not in
                                  ("PermissionDenied", "PermissionRequest", "post", "failure")))]
    calls_per = Counter(r["session"] for r in calls if r["session"])
    per_session = [calls_per.get(s, 0) for s in sessions]
    stops = [r for r in recs if r["outcome"] is not None and
             (r["event"] == "Stop" or (r["event"] != "SubagentStop" and not r["agent_id"]))]

    def runtime_stop(r):
        # SubagentStop of the runtime's own helper agents: no type, no tool calls
        return not r["agent_type"] and r["raw"].get("tool_calls") == 0
    all_sub = [r for r in recs if r["outcome"] is not None and r["event"] == "SubagentStop"]
    sub_stops = [r for r in all_sub if not runtime_stop(r)]
    # a session's outcome is its LAST Stop: earlier turns may end while a role runs in the
    # background (`waiting`), which is not a session without an outcome
    last_stop = {}
    for r in sorted((r for r in stops if r["session"]), key=lambda r: r["ts"].timestamp() if r["ts"] else float("-inf")):
        last_stop[r["session"]] = r
    gates = [r for r in recs if r["event"] == "gate"]
    denied = [r for r in recs if r["event"] != "gate" and (
              r["event"] == "PermissionDenied" or
              str(r["raw"].get("decision", "")).lower() in ("deny", "denied") or
              r["raw"].get("denied") is True)]
    requests = [r for r in recs if r["event"] == "PermissionRequest"]
    # heuristic: pre without post/failure (deny-rule refusals, interrupted calls)
    bal = Counter()
    for r in recs:
        k = (r["session"], r["agent_id"], r["tool"], r["detail"])
        if r["event"] == "pre":
            bal[k] += 1
        elif r["event"] in ("post", "failure"):
            bal[k] -= 1
    unmatched = Counter()
    for (s, a, tool, d), v in bal.items():
        if v > 0:
            unmatched[tool] += v

    def is_spawn(r):
        return (r["tool"] in ("Agent", "Task") and r["event"] in ("pre", "")
                and bool(rv.search(r["subagent_type"] or r["detail"])))

    actual = {s for s, rs in sessions.items()
              if any(is_spawn(r) or rv.search(r["agent_type"] or "\x00") for r in rs)}
    any_sub = {s for s, rs in sessions.items()
               if any((r["tool"] in ("Agent", "Task") and r["event"] in ("pre", "")) or
                      r["agent_id"] for r in rs)}
    claim_fields = opt.review_claim_field
    crx = re.compile(opt.review_claim_regex, re.I)
    claimed = {s for s, rs in sessions.items()
               if any(claims_review(r["raw"].get(f), crx) for r in rs for f in claim_fields)}
    out = {
        "sessions": count(n_s if recs else None, src + " - distinct session_id", len(recs)),
        "tool_calls": count(len(calls) if recs else None, src + " - `pre` tool events", len(calls)),
        "tool_calls_per_session_median": number(quantile(per_session, .5) if per_session else None,
                                                len(per_session), src),
        "tool_calls_per_session_p75": number(quantile(per_session, .75) if per_session else None,
                                             len(per_session), src),
        "tool_calls_per_session_max": number(max(per_session) if per_session else None,
                                             len(per_session), src),
        "sessions_without_outcome": share(
            sum(1 for r in last_stop.values() if str(r["outcome"]) in ("none", "", "waiting")),
            len(last_stop), src + " - last Stop of each session: outcome none, or still waiting "
                                  "on a background agent"),
        "gate_warnings": count(sum(1 for r in gates if r["raw"].get("decision") == "warn")
                               if recs else None, src + " - gates.jsonl, gate-first warnings", len(recs)),
        "gate_denials": count(sum(1 for r in gates if r["raw"].get("decision") == "deny")
                              if recs else None, src + " - gates.jsonl, denials", len(recs)),
        "sessions_with_reviewer_evidence": share(len(actual), n_s, src + " - reviewer spawn or "
                                                 "reviewer agent_type in the session"),
        "permission_denials": count(len(denied) if recs else None,
                                    src + " - PermissionDenied (auto-mode denials)", len(recs)),
        "permission_requests": count(len(requests) if recs else None,
                                     src + " - PermissionRequest", len(recs)),
    }
    if claimed:
        out["claimed_review_with_evidence"] = share(len(claimed & actual), len(claimed),
                                                    src + " - sessions with a review-claim field "
                                                    "(%s)" % "/".join(claim_fields))
        out["claimed_review_with_any_subagent"] = share(
            len(claimed & any_sub), len(claimed),
            src + " - upper bound: any subagent spawned (for journals that do not record the "
                  "subagent type)")
    else:
        out["claimed_review_with_evidence"] = nodata(src + " - no review-claim field in records "
                                                     "(%s)" % "/".join(claim_fields), "share")
        out["claimed_review_with_any_subagent"] = nodata(src + " - no review claims", "share")
    if typed_since is not None:
        # before typed_since the journal saw subagent calls but not their type: counting
        # those sessions as "no reviewer" would be a false zero, so they are left out
        first = {s: min((r["ts"] for r in rs if r["ts"]), default=None) for s, rs in sessions.items()}
        old = {s for s, t in first.items() if t is None or t < typed_since}
        why = "sessions before %s left out: subagent type not journaled" % (
            typed_since.strftime("%Y-%m-%d"))
        out["sessions_with_reviewer_evidence"] = share(
            len(actual - old), n_s - len(old),
            out["sessions_with_reviewer_evidence"]["source"] + " - " + why)
        if claimed:
            out["claimed_review_with_evidence"] = share(
                len((claimed - old) & actual), len(claimed - old),
                out["claimed_review_with_evidence"]["source"] + " - " + why)
    if tasks is not None:
        tss = [r["ts"] for r in recs if r["ts"]]
        if tss:
            lo, hi = min(tss), max(tss)
            spawned = set()
            for r in recs:
                if is_spawn(r):
                    spawned.update(r["task_ids"])
            approved = [t for t, x in tasks.items() if x["approved_at"] and lo <= x["approved_at"] <= hi]
            if any(r["task_ids"] for r in recs):
                out["approvals_with_reviewer_spawn"] = share(
                    sum(1 for t in approved if t in spawned), len(approved),
                    "-> CODE_COMPLETE transitions inside the journal's time span vs journaled "
                    "reviewer spawns naming the task")
            else:           # a journal that never records task ids cannot show a match
                out["approvals_with_reviewer_spawn"] = nodata(
                    "journal records carry no task_ids", "share")
        else:
            out["approvals_with_reviewer_spawn"] = nodata(
                "journal records carry no timestamps" if recs else "no journal records in period",
                "share")
    else:
        out["approvals_with_reviewer_spawn"] = nodata("no task transitions to compare with", "share")
    if not recs:
        for k in out:
            out[k]["value"] = None
    breakdown = {
        "outcomes": dict(Counter(str(r["outcome"]) for r in stops).most_common()),
        "subagent_outcomes": dict(Counter(str(r["outcome"]) for r in sub_stops).most_common()),
        "denials_by_tool": dict(Counter(r["tool"] or "?" for r in denied).most_common()),
        "unmatched_pre_by_tool": dict(unmatched.most_common()),
        "calls_by_tool": dict(Counter(r["tool"] or "?" for r in calls).most_common(opt.top)),
        "gate_decisions": dict(Counter("%s %s" % (r["raw"].get("gate") or "?", r["raw"].get("decision") or "?")
                                       for r in gates).most_common()),
        "n_stop_records": len(stops), "n_subagent_stop_records": len(sub_stops),
        "n_runtime_subagent_stops": len(all_sub) - len(sub_stops),
    }
    return out, breakdown


def journal_section(opt, periods, tasks):
    files, recs, bad = load_journal(opt)
    src = "hook journal"
    if not files:
        return {"status": NO_DATA, "reason": "no journal files found (default .teamwright/logs/; "
                                             "use --logs)", "source": src}
    if not recs:
        return {"status": NO_DATA, "reason": "journal files contain no JSON records",
                "source": src, "files": [os.path.basename(f) for f in files]}
    in_range = [r for r in recs if r["ts"] is None or in_period(r["ts"], opt.since_dt, opt.until_dt)]
    join = join_claims_by_time(in_range, opt)
    # journals that started recording the subagent type late: from when is "no reviewer" real?
    spawns = [r for r in in_range if r["tool"] in ("Agent", "Task") and r["event"] in ("pre", "")
              and r["ts"]]
    typed = [r["ts"] for r in spawns if r["subagent_type"] or r["detail"]]
    untyped = [r["ts"] for r in spawns if not (r["subagent_type"] or r["detail"])]
    typed_since = None
    if untyped and not any(r["agent_type"] for r in in_range):
        typed_since = min(typed) if typed else dt.datetime.max.replace(tzinfo=UTC)
        if typed and min(untyped) >= typed_since:
            typed_since = None
    # a session belongs to the period of its first timestamp
    first = {}
    for r in in_range:
        if r["ts"] and r["session"] and (r["session"] not in first or r["ts"] < first[r["session"]]):
            first[r["session"]] = r["ts"]
    summary, breakdown = {}, {}
    for name, a, b in periods:
        if a is None and b is None:
            rs = in_range
        else:
            rs = [r for r in in_range if (first.get(r["session"]) or r["ts"]) and
                  in_period(first.get(r["session"]) or r["ts"], a, b)]
        summary[name], breakdown[name] = journal_period_summary(rs, opt, tasks, src, typed_since)
    return {"source": src, "files": [os.path.basename(f) for f in files],
            "n_records": len(in_range), "unparsed_fragments": bad, "claim_join": join,
            "subagent_type_since": typed_since.strftime("%Y-%m-%d") if typed_since and
            typed_since.year < 9999 else ("never" if typed_since else None),
            "records_without_ts": sum(1 for r in in_range if r["ts"] is None),
            "summary": summary, "breakdown": breakdown}


# ---------------------------------------------------------------- rendering

def fmt(m):
    if isinstance(m, dict) and m.get("unreliable"):
        raw = dict(m, value=m.get("raw_value"), unreliable=False)
        return "unreliable (raw %s)" % fmt(raw)
    if not isinstance(m, dict) or m.get("value") is None:
        return NO_DATA
    v, k = m["value"], m["kind"]
    if k == "share":
        return "%.1f%% (%d/%d)" % (100 * v, m["num"], m["n"])
    if k == "days":
        return "%s d (n=%d)" % (fmtnum(v), m["n"])
    if k == "count":
        return "%d" % v
    return "%s (n=%d)" % (fmtnum(v), m["n"])


def fmtnum(v):
    return ("%.2f" % v).rstrip("0").rstrip(".") if isinstance(v, float) else str(v)


def delta(a, b):
    if (a or {}).get("unreliable") or (b or {}).get("unreliable"):
        return "unreliable"
    if not a or not b or a.get("value") is None or b.get("value") is None:
        return NO_DATA
    d = b["value"] - a["value"]
    if a["kind"] == "share":
        return "%+.1f pp" % (100 * d)
    if a["kind"] == "days":
        return "%+.2f d" % d
    if a["kind"] == "count":
        return "%+d" % d
    return "%+.2f" % d


def summary_table(summary, periods, labels):
    names = [p[0] for p in periods]
    head = "| Metric | " + " | ".join(names) + (" | Δ (after − before)" if len(names) == 2 else "") \
           + " | Source |"
    lines = [head, "|" + "---|" * (len(names) + (3 if len(names) == 2 else 2))]
    first = summary[names[0]]
    for key in first:
        cells = [fmt(summary[n].get(key)) for n in names]
        if len(names) == 2:
            cells.append(delta(summary[names[0]].get(key), summary[names[1]].get(key)))
        src = next((summary[n][key].get("source", "") for n in names
                    if summary[n].get(key, {}).get("value") is not None),
                   first[key].get("source", ""))
        why = next((summary[n][key]["reason"] for n in names
                    if summary[n].get(key, {}).get("unreliable")), None)
        if why:
            src += " - UNRELIABLE: %s" % why
        lines.append("| %s | %s | %s |" % (labels.get(key, key.replace("_", " ")),
                                           " | ".join(cells), src))
    return lines


def pct(num, den):
    return "%.1f%% (%d/%d)" % (100.0 * num / den, num, den) if den else NO_DATA


def render_md(rep, periods):
    L = ["# Process metrics - %s" % rep["repo"], ""]
    L.append("Generated %s. Range: %s .. %s%s." % (
        rep["generated"], rep["params"]["since"] or "start", rep["params"]["until"] or "now",
        ("; split at %s" % rep["params"]["split_date"]) if rep["params"]["split_date"] else ""))
    L.append("")
    L.append("Every number comes from git history or hook journals, never from an agent's "
             "report. Cells show the value with its n; `no data` means the source is missing, "
             "not zero. Meanings and biases: `docs/process/metrics.md`.")
    L.append("")

    g = rep["git"]
    L += ["## 1. Git history", ""]
    if g.get("status") == NO_DATA:
        L += ["%s - %s. Source: %s." % (NO_DATA, g["reason"], g["source"]), ""]
    else:
        L += ["Source: `%s`, %d commits in range; area = %s%s; excluded paths: `%s`." % (
            g["source"], g["n_commits"], g["params"]["area"],
            (" (depth %d)" % g["params"]["area_depth"]) if g["params"]["area_depth"] else "",
            g["params"]["exclude_regex"] or "none"), ""]
        for b in g["trailer_breaks"]:
            L += ["> **Warning - trailer-coverage break from %s to %s** (%d weeks, %d commits): "
                  "the agent co-authored share fell from a baseline of %.0f%% to %.0f%%. That is "
                  "what a settings change or a squash policy looks like, not less agent work. "
                  "The agent share is marked unreliable for any period that overlaps it; the "
                  "row \"weeks with trailer coverage\" leaves those weeks out." % (
                      b["from"], b["to"] or "the end of history", b["weeks"],
                      b["commits_in_low_weeks"], 100 * b["baseline_share"],
                      100 * b["share_in_break"]), ""]
        L += summary_table(g["summary"], periods, {
            "agent_coauthored_share": "agent co-authored commits",
            "agent_coauthored_share_covered": "agent co-authored (weeks with trailer coverage)",
            "recurrence_rate": "recurrence rate (fixes)",
            "tasks_fixed_again": "tasks fixed again",
        }) + [""]
        L += ["### Per month", "",
              "| Month | Commits | Agent co-authored | Fix commits | Reverts | Recurrence rate |",
              "|---|---|---|---|---|---|"]
        for r in g["monthly"]:
            L.append("| %s | %d | %s%s | %s | %d | %s |" % (
                r["month"], r["commits"], pct(r["agent_coauthored"], r["work_commits"]),
                " (coverage break)" if r["trailer_break"] else "",
                pct(r["fixes"], r["work_commits"]), r["reverts"],
                pct(r["recurrent_fixes"], r["fixes_with_area"])))
        L += ["", "Shares are over work commits (ledger commits, subject matching `%s`, left "
              "out). Recurrence rate: fix commits touching an area that had a fix in the previous "
              "%d days / fix commits with at least one counted file." % (
                  g["params"]["ledger_regex"], g["params"]["recurrence_days"]), ""]
        L += ["### Agent co-authors", ""]
        if g["agent_models"]:
            L += ["| Agent family | Commits |", "|---|---|"]
            L += ["| %s | %d |" % row for row in g["agent_families"].items()]
            L += ["", "| Normalized co-author | Commits |", "|---|---|"]
            L += ["| %s | %d |" % row for row in g["agent_models"].items()]
        else:
            L.append("No Co-Authored-By trailer matched an agent pattern (n=%d commits). Either no "
                     "agent commits, or agents commit without the trailer - check before reading "
                     "this as zero." % g["n_commits"])
        L += ["", "### Recurring areas (>= %d fix commits within %d days)" % (
            g["params"]["min_fixes"], g["params"]["window_days"]), ""]
        if g["recurring_areas"]:
            L += ["| Area | Fixes in window | Window | Fixes total |", "|---|---|---|---|"]
            for r in g["recurring_areas"][:rep["params"]["top"]]:
                L.append("| `%s` | %d | %s .. %s | %d |" % (r["area"], r["fixes_in_window"],
                                                         r["window_start"], r["window_end"],
                                                         r["fixes_total"]))
        else:
            L.append("None found (n=%d fix commits)." % sum(r["fixes"] for r in g["monthly"]))
        L += ["", "### Hotspots (churn × fix commits)", ""]
        if g["hotspots"]:
            L += ["| Area | Churn (lines) | Fix commits | Commits | Score |", "|---|---|---|---|---|"]
            for r in g["hotspots"]:
                L.append("| `%s` | %d | %d | %d | %d |" % (r["area"], r["churn"], r["fixes"],
                                                        r["commits"], r["score"]))
        else:
            L.append("No area received a fix commit.")
        L.append("")

    t = rep["tasks"]
    L += ["## 2. Task lifecycle", ""]
    if t.get("status") == NO_DATA:
        L += ["%s - %s. Source: %s." % (NO_DATA, t["reason"], t["source"]), ""]
        if t.get("parse_coverage"):
            L += coverage_lines(t["parse_coverage"])
    else:
        L += ["Source: %s - %d transitions, %d tasks in range (a task belongs to the period of "
              "its last DONE, or of its last transition if not done)%s." % (
                  t["source"], t["n_events"], t["n_tasks"],
                  ("; review rounds from `%s`" % t["review_source"]) if t["review_source"] else
                  "; review rounds from transitions (no review records committed)"), ""]
        L += coverage_lines(t["parse_coverage"])
        if t["task_period"] == "start":
            L += ["Tasks are grouped by the period they started in (`--task-period start`).", ""]
        L += summary_table(t["summary"], periods, {
            "cycle_days_median": "cycle time, median", "cycle_days_p75": "cycle time, p75",
            "lead_days_median": "lead time, median", "lead_days_p75": "lead time, p75",
            "rework_rate": "rework rate",
        }) + [""]
        L += ["### Per month", "", "| Month | Tasks created | Tasks done | Rework events |",
              "|---|---|---|---|"]
        for r in t["monthly"]:
            L.append("| %s | %d | %d | %d |" % (r["month"], r["created"], r["done"],
                                               r["rework_events"]))
        L += ["", "### Per sprint", ""]
        sp = t["sprints"]
        if sp.get("status") == NO_DATA:
            L.append("%s - %s." % (NO_DATA, sp["reason"]))
        else:
            L += ["Source: %s (n=%d tasks)." % (sp["source"], sp["n_tasks_with_sprint"]), "",
                  "| Sprint | Tasks | Done | Reworked |", "|---|---|---|---|"]
            for r in sp["rows"]:
                L.append("| %s | %d | %d | %d |" % (r["sprint"], r["tasks"], r["done"], r["reworked"]))
        L.append("")

    j = rep["journal"]
    L += ["## 3. Hook journals", ""]
    if j.get("status") == NO_DATA:
        L += ["%s - %s." % (NO_DATA, j["reason"]), ""]
    else:
        L += ["Source: %s - files %s, %d records, claims joined to sessions by %s%s%s%s." % (
            j["source"], ", ".join("`%s`" % f for f in j["files"]), j["n_records"], j["claim_join"],
            ("; subagent type journaled only from %s (earlier sessions left out of reviewer "
             "evidence)" % j["subagent_type_since"]) if j.get("subagent_type_since") else "",
            (", %d unparsed fragments skipped" % j["unparsed_fragments"]) if j["unparsed_fragments"] else "",
            (", %d records without timestamp (not split by period)" % j["records_without_ts"])
            if j["records_without_ts"] else ""), ""]
        L += summary_table(j["summary"], periods, {
            "claimed_review_with_evidence": "sessions claiming review: with reviewer evidence",
            "claimed_review_with_any_subagent": "sessions claiming review: any subagent (upper bound)",
            "approvals_with_reviewer_spawn": "approvals (-> CODE_COMPLETE) with a journaled reviewer spawn",
        }) + [""]
        for name, _, _ in periods:
            b = j["breakdown"][name]
            L += ["### Breakdown - %s" % name, ""]
            L.append("- Session outcomes (Stop, n=%d): %s" % (b["n_stop_records"], kv(b["outcomes"])))
            L.append("- Subagent outcomes (SubagentStop, n=%d; %d runtime helper stops without "
                     "type or tool calls left out): %s" % (b["n_subagent_stop_records"],
                                                           b.get("n_runtime_subagent_stops", 0),
                                                           kv(b["subagent_outcomes"])))
            L.append("- Gate decisions: %s" % kv(b.get("gate_decisions", {})))
            L.append("- Permission denials by tool: %s" % kv(b["denials_by_tool"]))
            L.append("- `pre` without `post`/`failure` by tool (heuristic: deny-rule refusals or "
                     "interrupted calls): %s" % kv(b["unmatched_pre_by_tool"]))
            L.append("- Tool calls by tool (top %d): %s" % (rep["params"]["top"], kv(b["calls_by_tool"])))
            L.append("")
    return "\n".join(L).rstrip() + "\n"


def coverage_lines(cv):
    L = ["Parse coverage (%s regex): %s of ledger commits carry at least one parsed transition; "
         "%d transitions from %d commits; %d ledger commits contain an arrow and a task id but "
         "parsed nothing%s." % (
             cv["regex"], pct(cv["ledger_with_transition"], cv["ledger_commits"]),
             cv["transitions"], cv["commits_with_transition"], cv["ledger_with_arrow_unparsed"],
             "" if "unmatched_sample" in cv else " (`--debug` lists them)"), ""]
    if cv.get("unmatched_sample"):
        L += ["Unmatched ledger subjects (sample, arrow first):", ""]
        L += ["- %s %s`%s`" % (u["date"], "(arrow) " if u["has_arrow"] else "",
                               u["subject"].replace("`", "'")) for u in cv["unmatched_sample"]]
        L.append("")
    return L


def kv(d):
    return ", ".join("%s %s" % (k, v) for k, v in d.items()) if d else NO_DATA


