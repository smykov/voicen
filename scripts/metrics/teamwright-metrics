def read_blobs(repo, rev, paths):
    """{path: text} for paths at rev, via one git cat-file --batch call."""
    if not paths:
        return {}
    inp = "".join("%s:%s\n" % (rev, p) for p in paths).encode()
    p = subprocess.run(["git", "-C", repo, "cat-file", "--batch"], input=inp,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    data, out, i = p.stdout, {}, 0
    for path in paths:
        nl = data.find(b"\n", i)
        if nl < 0:
            break
        header = data[i:nl].split()
        i = nl + 1
        if len(header) == 3 and header[1] == b"blob":
            size = int(header[2])
            out[path] = data[i:i + size].decode("utf-8", "replace")
            i += size + 1
    return out


def front_value(text, key):
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return ""
    for line in lines[1:]:
        if line.strip() == "---":
            break
        m = re.match(r"^%s:\s*(.*)$" % re.escape(key), line)
        if m:
            return m.group(1).split("#", 1)[0].strip().strip("'\"")
    return ""


def task_records(opt, id_re):
    """Committed task and review records (at --rev), or None when there are none."""
    tdir = opt.tasks_dir.strip("/")
    out = git(opt.repo, "ls-tree", "-r", "--name-only", opt.rev, "--", tdir, check=False)
    if not out:
        return None
    tasks, reviews = {}, defaultdict(list)
    rx_task = re.compile(r"^%s/(%s)\.md$" % (re.escape(tdir), id_re))
    rx_rev = re.compile(r"^%s/(%s)\.reviews/(\d+)\.md$" % (re.escape(tdir), id_re))
    for p in out.splitlines():
        m = rx_task.match(p)
        if m:
            tasks[m.group(1)] = p
            continue
        m = rx_rev.match(p)
        if m:
            reviews[m.group(1)].append(p)
    if not tasks and not reviews:
        return None
    blobs = read_blobs(opt.repo, opt.rev, list(tasks.values()) + [p for v in reviews.values()
                                                                    for p in v])
    created = {}
    log = git(opt.repo, "log", "--diff-filter=A", "--no-renames", "--format=%x1e%aI",
              "--name-only", opt.rev, "--", tdir, check=False) or ""
    for chunk in log.split("\x1e"):
        lines = [x for x in chunk.strip().splitlines() if x.strip()]
        if not lines:
            continue
        d = parse_ts(lines[0])
        for p in lines[1:]:
            m = rx_task.match(p.strip())
            if m and d and (m.group(1) not in created or d < created[m.group(1)]):
                created[m.group(1)] = d
    return {
        "sprint": {t: front_value(blobs.get(p, ""), "sprint") for t, p in tasks.items()},
        "created": created,
        "reviews": {t: [norm_status(front_value(blobs.get(p, ""), "verdict")) for p in
                        sorted(ps, key=lambda x: int(re.search(r"(\d+)\.md$", x).group(1)))]
                    for t, ps in reviews.items()},
        "n_task_files": len(tasks),
        "has_review_dirs": bool(reviews),
    }


ARROW_RE = re.compile(r"→|->|=>")


def parse_transitions(commits, opt, aliases):
    id_re = opt.task_id_regex
    try:
        rx = re.compile(opt.transition_regex.replace("<ID>", "(?:%s)" % id_re), re.M)
    except re.error as e:
        die("--transition-regex does not compile: %s" % e)
    if "to" not in rx.groupindex or not ({"ids", "id"} & set(rx.groupindex)):
        die("--transition-regex needs named groups (?P<ids>...) (or id) and (?P<to>...)")
    idg = "ids" if "ids" in rx.groupindex else "id"
    id_rx = re.compile(id_re)
    tolerant = opt.transition_regex == DEFAULT_TRANSITION_RE
    known = KNOWN_STATUSES | set(aliases) | set(aliases.values())
    ledger = re.compile(opt.ledger_regex, re.I) if opt.ledger_regex else None
    sprint_rx = re.compile(opt.sprint_regex) if opt.sprint_regex else None
    events, sprints = [], {}
    cov = {"ledger_commits": 0, "ledger_with_transition": 0, "commits_with_transition": 0,
           "transitions": 0, "ledger_with_arrow_unparsed": 0, "unmatched": []}

    def status_ok(raw):
        # tolerant default only: SHOUTED words of 3+ letters, or anything that maps to a
        # known status; "T-1 foo -> bar" is prose, not a transition
        if not tolerant:
            return True
        return (raw.isupper() and len(raw) >= 3) or aliases.get(norm_status(raw),
                                                               norm_status(raw)) in known

    for order, c in enumerate(commits):
        found = []
        is_ledger = bool(ledger and ledger.search(c["subject"]))
        matches = [m for m in rx.finditer(c["body"]) if status_ok(m.group("to"))]
        if tolerant and is_ledger and not matches:
            matches = [m for m in clause_matches(c["body"], id_rx) if status_ok(m.group("to"))]
        for m in matches:
            raw_to = m.group("to")
            raw_fr = m.group("from") if "from" in rx.groupindex and m.group("from") else ""
            if raw_fr and not status_ok(raw_fr):
                raw_fr = ""
            to, fr = norm_status(raw_to), norm_status(raw_fr)
            to, fr = aliases.get(to, to), aliases.get(fr, fr)
            for im in id_rx.finditer(m.group(idg) or ""):
                tid = im.group(0)
                found.append(tid)
                events.append({"task": tid, "from": fr, "to": to, "date": c["date"],
                               "order": order, "sha": c["sha"]})
        cov["ledger_commits"] += is_ledger
        if found:
            cov["commits_with_transition"] += 1
            cov["ledger_with_transition"] += is_ledger
            cov["transitions"] += len(found)
        elif is_ledger:
            arrow = bool(ARROW_RE.search(c["body"]) and id_rx.search(c["body"]))
            cov["ledger_with_arrow_unparsed"] += arrow
            cov["unmatched"].append((arrow, c["date"].strftime("%Y-%m-%d"), c["subject"][:160]))
        if sprint_rx and found:
            sm = sprint_rx.search(c["body"])
            if sm:
                label = sm.group(1) if sm.groups() else sm.group(0)
                for tid in found:
                    sprints.setdefault(tid, label)
    # unmatched sample: subjects with an arrow first (likely parser misses), newest first
    um = sorted(cov["unmatched"], key=lambda u: u[1], reverse=True)
    um.sort(key=lambda u: not u[0])                     # stable: arrow first, then by date
    cov["unmatched"] = [{"date": d, "has_arrow": a, "subject": subj} for a, d, subj in um]
    return events, sprints, cov


CLAUSE_ARROW_RE = re.compile(r"(?:(?P<from>[A-Za-z][A-Za-z_]*)[ \t]*)?(?:→|->|=>)[ \t]*"
                             r"(?P<to>[A-Za-z][A-Za-z_]*)\b")


class _Clause(object):
    """Match-like object for clause attribution (groups ids / from / to)."""

    def __init__(self, ids, fr, to):
        self.g = {"ids": ids, "id": ids, "from": fr, "to": to}

    def group(self, k):
        return self.g.get(k)


def clause_matches(body, id_rx):
    """Fallback for ledger commits the regex could not read: 'T-7 review done -> DONE',
    'T-1+T-2 analysis (root found) → NEEDS_REVIEW'. An arrow with a status is attributed
    to the task ids written before it in the same clause (clauses split on ; · | and line
    ends); an arrow with no id before it in its clause is skipped."""
    out = []
    for line in body.splitlines():
        start = 0
        for m in CLAUSE_ARROW_RE.finditer(line):
            seg_start = max(start, *(line.rfind(sep, 0, m.start()) + 1 for sep in ";·|"))
            ids = " ".join(x.group(0) for x in id_rx.finditer(line, seg_start, m.start()))
            start = m.end()
            if ids:
                out.append(_Clause(ids, m.group("from") or "", m.group("to")))
    return out


def sprint_from_id(tid, rx):
    m = rx.search(tid)
    if not m:
        return None
    return m.group(1) if m.groups() else m.group(0)


def build_tasks(events, records):
    # "reached review" = entered NEEDS_REVIEW, when the history uses that status at all;
    # otherwise (another convention) any status from review onwards
    has_review = any(e["to"] == "NEEDS_REVIEW" or e["from"] == "NEEDS_REVIEW" for e in events)
    by = defaultdict(list)
    for e in events:
        by[e["task"]].append(e)
    tasks = {}
    for tid, evs in by.items():
        evs.sort(key=lambda e: (e["date"], e["order"]))
        prev = ""
        for e in evs:                  # "T-7 → DONE": from = the task's previous status
            if not e["from"] and prev:
                e["from"], e["from_inferred"] = prev, True
            prev = e["to"]
        first = evs[0]["date"]
        if records and tid in records["created"]:
            first = min(first, records["created"][tid])
        started = next((e["date"] for e in evs if e["to"] in START or e["from"] == "TODO"), None)
        done = None
        if evs[-1]["to"] == "DONE":
            done = evs[-1]["date"]
        if has_review:
            reached = any(e["to"] == "NEEDS_REVIEW" or e["from"] == "NEEDS_REVIEW" for e in evs)
        else:
            reached = any(e["to"] in LATE or e["from"] in LATE or e["to"] == "DONE" for e in evs)
        rework = [e for e in evs if e["from"] in REWORK_FROM and e["to"] in REWORK_TO]
        tasks[tid] = {
            "first_seen": first, "started": started, "done": done, "last": evs[-1]["date"],
            "reached_review": reached, "rework_events": len(rework),
            "review_rounds_transitions": max(sum(1 for e in evs if e["to"] == "NEEDS_REVIEW"),
                                             sum(1 for e in evs if e["from"] == "NEEDS_REVIEW")),
            "approved": any(e["to"] == "CODE_COMPLETE" for e in evs),
            "approved_at": next((e["date"] for e in evs if e["to"] == "CODE_COMPLETE"), None),
            "escalations": sum(1 for e in evs if e["from"] == "NEEDS_REVIEW" and e["to"] == "BLOCKED"),
            "recurrence_rejects": sum(1 for e in evs if e["from"] == "NEEDS_REVIEW"
                                      and e["to"] == "DEFERRED"),
            "verify_fails": sum(1 for e in evs if e["to"] == "VERIFY_FAIL"),
            "final": evs[-1]["to"],
        }
    return tasks


def task_period_summary(ts, evs, records, src, rev_src):
    """ts: {id: task} belonging to the period; evs: transition events in the period."""
    n = len(ts)
    cyc = [days_between(t["started"], t["done"]) for t in ts.values() if t["started"] and t["done"]]
    lead = [days_between(t["first_seen"], t["done"]) for t in ts.values() if t["done"]]
    reviewed = [t for t in ts.values() if t["reached_review"]]
    out = {
        "tasks_seen": count(n, src, n),
        "tasks_done": count(sum(1 for t in ts.values() if t["done"]), src, n),
        "cycle_days_median": number(round(quantile(cyc, .5), 2) if cyc else None, len(cyc),
                                    src + " - first ANALYSIS/IN_PROGRESS -> last DONE", "days"),
        "cycle_days_p75": number(round(quantile(cyc, .75), 2) if cyc else None, len(cyc),
                                 src + " - first ANALYSIS/IN_PROGRESS -> last DONE", "days"),
        "lead_days_median": number(round(quantile(lead, .5), 2) if lead else None, len(lead),
                                   src + " - first seen -> last DONE", "days"),
        "lead_days_p75": number(round(quantile(lead, .75), 2) if lead else None, len(lead),
                                src + " - first seen -> last DONE", "days"),
        "rework_rate": share(sum(1 for t in reviewed if t["rework_events"]), len(reviewed),
                             src + " - tasks sent back from review/verify to IN_PROGRESS/ANALYSIS"),
        "escalations": count(sum(1 for e in evs if e["from"] == "NEEDS_REVIEW"
                                 and e["to"] == "BLOCKED"), src + " - NEEDS_REVIEW -> BLOCKED",
                             len(evs)),
        "recurrence_rejects": count(sum(1 for e in evs if e["from"] == "NEEDS_REVIEW"
                                        and e["to"] == "DEFERRED"),
                                    src + " - NEEDS_REVIEW -> DEFERRED", len(evs)),
        "verify_failures": count(sum(1 for e in evs if e["to"] == "VERIFY_FAIL"),
                                 src + " - -> VERIFY_FAIL", len(evs)),
    }
    if records and records["has_review_dirs"]:
        rounds = [len(records["reviews"].get(t, [])) for t, x in ts.items() if x["reached_review"]]
        out["review_rounds_mean"] = number(round(sum(rounds) / len(rounds), 2) if rounds else None,
                                           len(rounds), rev_src + " (tasks that reached review)")
        appr = [t for t, x in ts.items() if x["approved"]]
        out["approved_without_review_record"] = share(
            sum(1 for t in appr if not records["reviews"].get(t)), len(appr),
            rev_src + " vs -> CODE_COMPLETE transitions")
        out["escalate_verdicts"] = count(sum(v.count("ESCALATE") for t, v in
                                             records["reviews"].items() if t in ts),
                                         rev_src + " - verdict ESCALATE", len(rounds))
    else:
        rounds = [x["review_rounds_transitions"] for x in reviewed]
        out["review_rounds_mean"] = number(round(sum(rounds) / len(rounds), 2) if rounds else None,
                                           len(rounds), src + " - entries into NEEDS_REVIEW "
                                           "(no review records in git)")
    if not n:
        for k in out:
            out[k]["value"] = None
    return out


def task_section(opt, periods, commits):
    src = "task-transition commits (%s)" % ("default convention" if opt.transition_regex ==
                                             DEFAULT_TRANSITION_RE else "--transition-regex")
    if not commits:
        return {"status": NO_DATA, "reason": "no git history", "source": src}
    aliases = load_aliases(opt.status_aliases)
    events, sprint_by_commit, cov = parse_transitions(commits, opt, aliases)
    in_rng = [c for c in commits if in_period(c["date"], opt.since_dt, opt.until_dt)]
    if len(in_rng) != len(commits):
        _, _, cov = parse_transitions(in_rng, opt, aliases)     # coverage for the range only
    coverage = {k: v for k, v in cov.items() if k != "unmatched"}
    coverage["regex"] = "default (tolerant)" if opt.transition_regex == DEFAULT_TRANSITION_RE \
        else "--transition-regex"
    if opt.debug:
        coverage["unmatched_sample"] = cov["unmatched"][:opt.debug_sample]
    records = task_records(opt, opt.task_id_regex)
    rev_src = "%s/<ID>.reviews/<n>.md at %s" % (opt.tasks_dir.strip("/"), opt.rev)
    if not events:
        return {"status": NO_DATA, "reason": "no task-transition lines matched", "source": src,
                "parse_coverage": coverage}
    tasks = build_tasks(events, records)
    rng = lambda d: in_period(d, opt.since_dt, opt.until_dt)   # noqa: E731
    if opt.task_period == "start":      # cohort: the period in which the task started
        key_date = lambda t: t["started"] or t["first_seen"]    # noqa: E731
    else:                               # the period of its last DONE (or last transition)
        key_date = lambda t: t["done"] or t["last"]             # noqa: E731
    in_range = {k: t for k, t in tasks.items() if rng(key_date(t))}
    evs_range = [e for e in events if rng(e["date"])]
    monthly = defaultdict(lambda: {"created": 0, "done": 0, "rework_events": 0})
    for t in tasks.values():
        if rng(t["first_seen"]):
            monthly[month(t["first_seen"])]["created"] += 1
        if t["done"] and rng(t["done"]):
            monthly[month(t["done"])]["done"] += 1
    for e in evs_range:
        if e["from"] in REWORK_FROM and e["to"] in REWORK_TO:
            monthly[month(e["date"])]["rework_events"] += 1
    summary = {}
    for name, a, b in periods:
        ts = {k: t for k, t in in_range.items() if in_period(key_date(t), a, b)}
        ev = [e for e in evs_range if in_period(e["date"], a, b)]
        summary[name] = task_period_summary(ts, ev, records, src, rev_src)
    # sprint: task record field first, else --sprint-from-id, else --sprint-regex
    sprint_src, sprint_of = None, {}
    if records and any(records["sprint"].values()):
        sprint_of = {t: s for t, s in records["sprint"].items() if s}
        sprint_src = "%s/<ID>.md front matter `sprint:`" % opt.tasks_dir.strip("/")
    elif opt.sprint_from_id:
        srx = re.compile(opt.sprint_from_id)
        sprint_of = {t: sprint_from_id(t, srx) for t in tasks}
        sprint_of = {t: v for t, v in sprint_of.items() if v}
        sprint_src = "--sprint-from-id over task ids (tasks seen in transitions)"
    if not sprint_of and sprint_by_commit:
        sprint_of, sprint_src = sprint_by_commit, "--sprint-regex over transition commits"
    sprints = None
    if sprint_of:
        agg = defaultdict(lambda: {"tasks": 0, "done": 0, "reworked": 0})
        for tid, t in in_range.items():
            s = sprint_of.get(tid)
            if s is None:
                continue
            agg[s]["tasks"] += 1
            agg[s]["done"] += 1 if t["done"] else 0
            agg[s]["reworked"] += 1 if t["rework_events"] else 0
        sprints = {"source": sprint_src, "n_tasks_with_sprint": sum(v["tasks"] for v in agg.values()),
                   "rows": [dict(sprint=k, **v) for k, v in sorted(agg.items(), key=lambda kv: sprint_key(kv[0]))]}
    return {"source": src, "n_events": len(evs_range), "n_tasks": len(in_range),
            "parse_coverage": coverage, "task_period": opt.task_period,
            "review_source": rev_src if records and records["has_review_dirs"] else None,
            "summary": summary,
            "monthly": [dict(month=m, **v) for m, v in sorted(monthly.items())],
            "sprints": sprints if sprints else {"status": NO_DATA,
                                                "reason": "no `sprint:` field in task records, no "
                                                          "--sprint-from-id or --sprint-regex match"},
            "_tasks": tasks}


def sprint_key(s):
    m = re.search(r"\d+", s)
    return (int(m.group(0)) if m else 1 << 30, s)


