#!/usr/bin/env python3
"""tw-launch - start the headless stage sessions of worktrees, with the CI-only push allowed (stdlib only).

The launch side of decisions #219 (T-192). The kit's tw-parallel.py prompt says "Do not push", while
the kit's red-tests stage orders the wip/<ID> push of P-016. This entry runs the kit's own `launch`
with $TEAMWRIGHT_CLAUDE_ARGS set to the kit's defaults and one sentence of the prompt changed: it
states that exception and orders the CI read through scripts/tw-wip-run (T-199, decisions #241).

The arguments are read from the installed kit, not copied, so a kit update carries its tools and
denials here. If the kit no longer has that sentence or one of the denials, this refuses and starts
nothing: a launch with the wrong prompt or without a denial is worse than no launch.

  scripts/tw-launch <ID> [<ID> ...]   run the kit's `tw-parallel.py launch` for these worktrees
  scripts/tw-launch --prepare <ID>... copy the main tree's Serena config in, then the kit's `prepare`
  scripts/tw-launch --print-args      print the value of TEAMWRIGHT_CLAUDE_ARGS and exit

Run it from the main tree's copy; the project is the tree this file is in. The kit is the version in
.teamwright/installed.json under ~/.claude/plugins/cache/teamwright/teamwright/, or
$TEAMWRIGHT_KIT_DIR. A launch without this entry falls back to the kit's defaults: the session is told
not to push, and stops as before.

With the kit's context provider `serena` (T-196, decisions #216): `.serena/project.yml` is untracked
(#16), so a new worktree has none and Serena would autogenerate one with other language servers.
`--prepare` copies the main tree's `.serena/project.yml`, `project.local.yml` and `memories/` files
into each worktree (absent or different; an overwrite is reported) before the kit's `prepare` indexes,
and a launch refuses a worktree whose project.yml is not byte-equal to the main tree's. A main tree
without project.yml stops both. Other providers: no copy, no check.
"""
import filecmp
import importlib.util
import json
import os
import shlex
import shutil
import sys

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
KIT_SENTENCE = "Do not push, do not merge."
OUR_SENTENCE = ("Do not merge. Do not push, with one exception: the CI-only wip/<ID> push a stage asks "
                "for is allowed only through scripts/tw-wip-push [<commit>], run from this worktree; "
                "no other push is allowed, by any command. "
                # T-199 (decisions #241): the stage's only CI read; Bash(gh:*) stays denied.
                "CI is read only through scripts/tw-wip-run, run from this worktree; gh itself stays "
                "denied. It waits for the run of the pushed commit and exits 3 while the run is still "
                "pending: call it again in the same stage. End the stage only with a CI: <run> @ <sha> "
                "line in ## Tests, a red run with its failed jobs named, or an escalation that names why "
                "no result came (exit 4: no run for the sha; exit 5: gh failed; exit 6: the run passed the "
                "90-minute wait ceiling); "
                "never with a note that CI is unread.")
KIT_DENIALS = ("Bash(git push:*)", "Bash(git merge:*)", "Bash(gh:*)")
# T-196: the provider whose untracked project config each worktree must share with the main tree.
SERENA = "serena"
SERENA_YML = os.path.join(".serena", "project.yml")
SERENA_COPIED = (SERENA_YML, os.path.join(".serena", "project.local.yml"))
SERENA_MEMORIES = os.path.join(".serena", "memories")


def refuse(reason):
    print("tw-launch: REFUSED - %s; nothing started" % reason, file=sys.stderr)
    sys.exit(2)


def kit_script():
    kit = os.environ.get("TEAMWRIGHT_KIT_DIR")
    if not kit:
        try:
            with open(os.path.join(ROOT, ".teamwright", "installed.json"), encoding="utf-8") as fh:
                version = json.load(fh)["@kit"]["version"]
        except (OSError, ValueError, KeyError, TypeError) as e:
            refuse("cannot read the kit version from .teamwright/installed.json (%s)" % e)
        kit = os.path.join(os.path.expanduser("~"), ".claude", "plugins", "cache", "teamwright", "teamwright", version)
    path = os.path.join(kit, "scripts", "tw-parallel.py")
    if not os.path.isfile(path):
        refuse("no kit launcher at %s" % path)
    return path


def load_kit(script):
    spec = importlib.util.spec_from_file_location("tw_parallel", script)
    kit = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(kit)
    return kit


def serena_worktrees(kit, ids):
    """[(id, worktree path)] of these ids when the provider is serena (else []); refuses a main
    tree without .serena/project.yml. An id with no worktree is left to the kit, which reports it."""
    if kit.context_provider(ROOT) != SERENA:
        return []
    if not os.path.isfile(os.path.join(ROOT, SERENA_YML)):
        refuse("the main tree has no %s (Serena would autogenerate one in each worktree)"
               % os.path.join(ROOT, SERENA_YML))
    wts = kit.worktrees(ROOT)
    return [(t, wts[t]["path"]) for t in ids if t in wts]


def same(a, b):
    return os.path.isfile(b) and filecmp.cmp(a, b, shallow=False)


def copy_in(tid, src, dst):
    """Copy src over dst unless they are byte-equal; an overwrite is reported."""
    if same(src, dst):
        return
    existed = os.path.exists(dst)
    try:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".tw-launch.tmp"
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
    except OSError as e:
        refuse("cannot copy %s to %s (%s)" % (src, dst, e))
    if existed:
        print("tw-launch: %s: overwrote %s (it differed from the main tree's)" % (tid, dst), file=sys.stderr)


def prepare_serena(kit, ids):
    for tid, wt in serena_worktrees(kit, ids):
        files = [rel for rel in SERENA_COPIED if os.path.isfile(os.path.join(ROOT, rel))]
        for base, _dirs, names in os.walk(os.path.join(ROOT, SERENA_MEMORIES)):
            files += [os.path.relpath(os.path.join(base, n), ROOT) for n in sorted(names)]
        for rel in files:
            copy_in(tid, os.path.join(ROOT, rel), os.path.join(wt, rel))


def check_serena(kit, ids):
    main_yml = os.path.join(ROOT, SERENA_YML)
    for tid, wt in serena_worktrees(kit, ids):
        dst = os.path.join(wt, SERENA_YML)
        if not same(main_yml, dst):
            refuse("%s: %s is %s the main tree's %s; run scripts/tw-launch --prepare %s"
                   % (tid, dst, "not byte-equal to" if os.path.exists(dst) else "missing, unlike",
                      main_yml, tid))


def launch_args(kit):
    args = list(kit.DEFAULT_ARGS)
    denied = " ".join(a for prev, a in zip(args, args[1:]) if prev == "--disallowedTools")
    missing = [d for d in KIT_DENIALS if d not in denied]
    if missing:
        refuse("the kit's defaults no longer deny %s" % ", ".join(missing))
    if sum(KIT_SENTENCE in a for a in args) != 1:
        refuse("the kit's prompt no longer says %r" % KIT_SENTENCE)
    return [a.replace(KIT_SENTENCE, OUR_SENTENCE) for a in args]


def main(argv):
    prep = argv[:1] == ["--prepare"]
    ids = argv[1:] if prep else argv
    if not ids or (argv != ["--print-args"] and any(a.startswith("-") for a in ids)):
        print(__doc__.split("\n\n")[3], file=sys.stderr)
        return 2
    script = kit_script()
    kit = load_kit(script)
    if prep:
        prepare_serena(kit, ids)
        os.execv(sys.executable, [sys.executable, script, "prepare", *ids, "--project", ROOT])
    value = shlex.join(launch_args(kit))
    if argv == ["--print-args"]:
        print(value)
        return 0
    check_serena(kit, ids)
    os.environ["TEAMWRIGHT_CLAUDE_ARGS"] = value
    os.execv(sys.executable, [sys.executable, script, "launch", *ids, "--project", ROOT])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
